# --- secrets ---------------------------------------------------------------
.env
.env.*
!.env.example

# --- python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
