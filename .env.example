# ============================================================================
# AlphaBrief — environment
#
# EVERY VALUE HERE IS OPTIONAL. You do not need this file at all: with no .env
# the system runs end to end — live market data, the full multi-agent graph,
# MCP tools, numeric verification, a durable human-approval gate that survives
# a restart, and the archive — on SQLite, at $0, with no account anywhere.
#
# Setting a value UPGRADES a stage. It never unlocks one. The single exception
# worth knowing: ANTHROPIC_API_KEY switches the reasoning from the deterministic
# engine to Claude. Everything else here is deployment plumbing.
# ============================================================================

# ---------------------------------------------------------------- runtime --
ENVIRONMENT=local                 # local | production
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR

# ------------------------------------------------------------- Claude API --
# Leave blank to run on the deterministic engine (free, no network to Anthropic).
ANTHROPIC_API_KEY=
LLM_ENGINE=auto                   # auto | anthropic | deterministic
MODEL_SUPERVISOR=claude-haiku-4-5   # cheap routing model
MODEL_WORKER=claude-sonnet-4-6      # data + news agents
MODEL_WRITER=claude-sonnet-4-6      # brief assembly
WORKER_EFFORT=medium              # low | medium | high
LLM_MAX_TOKENS=4096

# ------------------------------------------------------------- guardrails --
MAX_ITERATIONS=15                 # supervisor hard cap
TOKEN_BUDGET_USD=0.50             # per-run spend ceiling -> BUDGET_ABORT
TOKEN_BUDGET_TOKENS=400000        # per-run token ceiling -> BUDGET_ABORT
MAX_WATCHLIST_SIZE=12
MAX_REGENERATIONS=1               # one writer retry on a verification mismatch

# -------------------------------------------------------------------- MCP --
MCP_TRANSPORT=stdio               # stdio (spawns the server) | inmemory
MCP_SHARED_SERVER=false           # share one server + provider cache across runs
PRICE_HISTORY_DAYS=120
NEWS_LIMIT=6
PROVIDER_MIN_INTERVAL_SECONDS=0.20  # polite rate limiting for free providers
# Yahoo answers the first call from a cold session on a shared egress IP with a
# rate-limit error, then serves everything after it — so a single attempt loses
# the first ticker of every run on a hosted deployment. Bounded, and each retry
# is throttled like any other call.
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_RETRY_BACKOFF_SECONDS=0.75

# ------------------------------------------------------------ persistence --
# Local: SQLite. Production: your Neon connection string.
#
# Both are durable. A run paused at the approval gate is checkpointed to disk
# beside the archive (`*.checkpoints.db`) and survives a restart, so the gate is
# not something a reviewer can lose by closing a laptop lid. Postgres buys you a
# shared archive across instances, not the ability to pause.
#
# Quote a Neon URL: it contains `&`, which a bare shell `. .env` would read as a
# background-job operator.
DATABASE_URL=sqlite:///./alphabrief.db
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/alphabrief?sslmode=require&channel_binding=require"

# ---------------------------------------------------------- observability --
# Optional. Without these the tracer is a no-op and nothing is sent anywhere.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --------------------------------------------------------------- delivery --
# Optional. Gmail works with an app password (not your account password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# --------------------------------------------------------------- security --
# Bearer token for the approval endpoints. Leave it blank locally: on first boot
# the API mints a random one into `var/approval_token` (mode 600, gitignored)
# and the console reads the same file, so approval works on a fresh clone with
# nothing configured. There is deliberately no committed default — that would be
# a known credential on every deployment that forgot to set one.
#
# In production (ENVIRONMENT=production) the file handshake is disabled and this
# MUST be set, or each process gets its own random token and nothing can approve.
APPROVAL_TOKEN=
CORS_ALLOW_ORIGINS=http://localhost:3001
MAX_REQUEST_BYTES=65536

# ------------------------------------------------------------------- runs --
DEFAULT_WATCHLIST=AAPL,MSFT,NVDA,TSLA,AMZN
RUN_TIMEOUT_SECONDS=900

# ============================================================================
# apps/web (Next.js) — server-side only. The browser never sees these.
# ============================================================================
# Defaults to the port `make api` uses, so local development needs neither line.
ALPHABRIEF_API_URL=http://127.0.0.1:7877
# Leave blank locally — the console reads `var/approval_token`. Required in a
# deployment, where there is no shared filesystem to read it from.
ALPHABRIEF_APPROVAL_TOKEN=
ALPHABRIEF_DEFAULT_WATCHLIST=AAPL,MSFT,NVDA,TSLA,AMZN
# Set by Vercel when you add a Cron job; the trigger route verifies it.
CRON_SECRET=
